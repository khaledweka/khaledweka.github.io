---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../data/posts';

const posts = await getAllPosts();
---
<Base
  title="خالد الوكيل | قائد تقني ومهندس برمجيات أول"
  description="خالد الوكيل — قائد تقني ومهندس برمجيات أول بخبرة تتجاوز 12 عامًا. تطوير الواجهات الخلفية، PHP، Laravel، Node.js."
  lang="ar"
  langRedirect
  enPath="/index.html"
  arPath="/ar/index.html"
>
      <section class="hero container animate-in">
        <div class="hero-layout">
          <div class="hero-photo-wrap">
            <div class="hero-photo-fallback animate-in-delay-1">KA</div>
          </div>
          <div class="hero-text">
            <h1 class="hero-title animate-in-delay-2">خالد الوكيل</h1>
            <p class="hero-subtitle animate-in-delay-3">قائد تقني ومهندس برمجيات أول</p>
            <p class="hero-tagline animate-in-delay-4">أكثر من 12 عامًا في بناء أنظمة قابلة للتوسع، وربط التنفيذ التقني بأهداف العمل.</p>
          </div>
        </div>
      </section>

      <section class="site-stats-bar reveal-on-scroll" aria-label="إحصائيات الموقع">
        <div class="container site-stats-inner">
          <div class="site-stat" id="visitor-counter">
            <span class="site-stat-label">مشاهدات الصفحة</span>
            <span class="visitor-counter-value site-stat-value site-stat-value--pill" aria-busy="true">…</span>
          </div>
          <div class="site-stat">
            <span class="site-stat-label">مشاهدات المدونة</span>
            <span class="site-stat-value site-stat-value--pill" id="blog-views-value" aria-busy="true">…</span>
          </div>
          <div class="site-stat">
            <span class="site-stat-label">عدد المقالات</span>
            <a class="site-stat-value site-stat-link" href="/ar/blog/index.html">{posts.length}</a>
          </div>
          <div class="site-stat">
            <span class="site-stat-label">سنوات الخبرة</span>
            <span class="site-stat-value">+12 سنة</span>
          </div>
        
          <div class="site-stat">
            <span class="site-stat-label">آخر تحديث</span>
            <span class="site-stat-value" id="repo-pushed-at" aria-busy="true">…</span>
          </div>
        </div>
      </section>

      <section id="about" class="section reveal-on-scroll">
        <div class="container">
          <h2 class="section-title">نبذة</h2>
          <div class="section-content">
            <p class="about-text">
              قائد تقني ومهندس برمجيات أول بخبرة تتجاوز 12 عامًا في قطاع التقنية. سجل حافل في توظيف الخبرة التقنية ومهارات القيادة لإنجاز المشاريع المعقدة وتمكين فرق هندسية عالية الأداء. أجيد سد الفجوة بين التنفيذ التقني وأهداف العمل التجارية، مع روح تعاونية ومهارات قوية في إدارة المشاريع داخل بيئات سريعة الإيقاع.
            </p>
            <ul class="contact-list">
              <li>📍 مصر</li>
              <li><a href="tel:+201096828959">+201096828959</a></li>
              <li><a href="mailto:Khaled_elwakeel@outlook.com">Khaled_elwakeel@outlook.com</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section id="blog" class="section reveal-on-scroll">
        <div class="container">
          <h2 class="section-title">المدونة</h2>
          <p class="blog-intro">رؤى تقنية، وتطوير الواجهات الخلفية، وملاحظات في هندسة البرمجيات.</p>
          <ul class="post-list post-list-home">
            {posts.map((post) => <PostCard post={post} locale="ar" />)}
          </ul>
          <p class="blog-view-all">
            <a href="/ar/blog/index.html">عرض كل المقالات ←</a>
          </p>
        </div>
      </section>


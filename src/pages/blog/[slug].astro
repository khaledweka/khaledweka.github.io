---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const rawHtml = import.meta.glob('/src/content/raw/*.html', { query: '?raw', import: 'default', eager: true });
const rawCss = import.meta.glob('/src/content/raw/*.css', { query: '?raw', import: 'default', eager: true });

const { entry } = Astro.props;
const { Content } = entry.data.raw ? { Content: null } : await render(entry);
const dateLabel = entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Post
  title={entry.data.title}
  pageTitle={entry.data.pageTitle}
  description={entry.data.description ?? entry.data.excerpt}
  lang={entry.data.lang === 'ar' ? 'ar' : 'en'}
  dateLabel={dateLabel}
  selfPath={`/blog/${entry.id}.html`}
  raw={entry.data.raw ? rawHtml[`/src/content/raw/${entry.id}.html`] : undefined}
  rawCss={entry.data.raw ? rawCss[`/src/content/raw/${entry.id}.css`] : undefined}
>
  {Content && <Content />}
</Post>

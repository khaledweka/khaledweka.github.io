---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../data/posts';

const posts = await getAllPosts();
---
<Base
  title="Blog | Khaled Alwakeel"
  description="Blog - Khaled Alwakeel. Technical insights, backend development, and software engineering."
  langRedirect
  enPath="/blog/index.html"
  arPath="/ar/blog/index.html"
  inner
>
  <div class="container pt-3">
    <h1 class="hero-title">Blog</h1>
    <p class="blog-intro">Technical insights, backend development, and software engineering notes.</p>

    <ul class="post-list reveal-on-scroll">
      {posts.map((post) => <PostCard post={post} locale="en" headingLevel={2} />)}
    </ul>
  </div>
  <section class="giscus-section container" aria-label="Comments">
    <div id="giscus-container"></div>
  </section>
</Base>

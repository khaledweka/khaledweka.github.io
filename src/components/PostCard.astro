---
import type { Post } from '../data/posts';

interface Props {
    post: Post;
    locale: 'en' | 'ar';
    headingLevel?: 2 | 3;
}

const { post, locale, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;

const arMonths = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
const badges = { en: 'المقال بالإنجليزية', bi: 'المقال بالعربية والإنجليزية' };

const isAr = locale === 'ar';
const title = isAr ? (post.titleAr ?? post.title) : (post.cardTitle ?? post.title);
const excerpt = isAr ? (post.excerptAr ?? post.excerpt) : post.excerpt;
const dateText = isAr
    ? `${post.date.getUTCDate()} ${arMonths[post.date.getUTCMonth()]} ${post.date.getUTCFullYear()}`
    : post.dateLabel;
const badge = post.lang === 'ar' ? undefined : badges[post.lang];
---
<li class="post-item">
  <a href={post.href} class={post.image ? 'post-link post-link--with-thumb' : 'post-link'}>
    {post.image ? (
      <>
        <img src={post.image} alt={post.imageAlt ?? ''} class="post-item-thumb" width="132" height="74" loading="lazy" decoding="async">
        <div class="post-link-text">
          <Heading class="post-title">{title}</Heading>
          <p class="post-meta">{dateText}{isAr && (badge ? <> <span class="post-lang-badge" lang="ar">{badge}</span></> : ' ')}</p>
          <p class="post-excerpt">{excerpt}</p>
        </div>
      </>
    ) : (
      <>
        <Heading class="post-title">{title}</Heading>
        <p class="post-meta">{dateText}{isAr && (badge ? <> <span class="post-lang-badge" lang="ar">{badge}</span></> : ' ')}</p>
        <p class="post-excerpt">{excerpt}</p>
      </>
    )}
  </a>
</li>

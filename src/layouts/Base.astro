---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description: string;
    lang?: 'en' | 'ar';
    langRedirect?: boolean;
    enPath?: string;
    arPath?: string;
    selfPath?: string;
    inner?: boolean;
}

const { title, description, lang = 'en', langRedirect = false, enPath, arPath, selfPath, inner = false } = Astro.props;
const siteOrigin = 'https://khaledweka.github.io';
---
<!DOCTYPE html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} data-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    {selfPath && !langRedirect ? (
      <link rel="alternate" hreflang={lang} href={siteOrigin + selfPath}>
    ) : (
      <>
        <link rel="alternate" hreflang="en" href={siteOrigin + enPath}>
        <link rel="alternate" hreflang="ar" href={siteOrigin + arPath}>
        <link rel="alternate" hreflang="x-default" href={siteOrigin + enPath}>
      </>
    )}
    {langRedirect && (
      <script is:inline data-lang-redirect>
    /* Language preference — must run before render to avoid a flash of the wrong
       language. Mirrors counterpartPath() in js/main.js; keep the two in sync.
       Only present on pages that actually have a counterpart in the other tree:
       individual posts are not translated, so they must never redirect. */
    (function () {
      try {
        var p = location.pathname;
        var isAr = /(^|\/)ar\//.test(p);
        var stored = localStorage.getItem('lang');
        var want = stored === 'ar' || stored === 'en' ? stored
          : ((navigator.languages || [navigator.language || '']).some(function (l) {
              return /^ar\b/i.test(l || '');
            }) ? 'ar' : 'en');
        if (!stored) localStorage.setItem('lang', want);
        if ((want === 'ar') === isAr) return;
        var m = p.match(/^(.*?)\/ar\/(.*)$/), t;
        if (want === 'en') {
          t = m ? m[1] + '/' + m[2] : p;
        } else {
          var parts = p.split('/'), file = parts.pop();
          var isBlog = parts[parts.length - 1] === 'blog';
          if (isBlog) parts.pop();
          t = parts.join('/') + '/ar/' + (isBlog ? 'blog/' : '') + file;
        }
        if (t !== p) location.replace(t + location.search + location.hash);
      } catch (e) { /* storage blocked — stay put */ }
    })();
      </script>
    )}
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <div class="site-wrapper">
      <Header lang={lang} inner={inner} />
      <main class="main">
        <slot />
      </main>
      <Footer lang={lang} inner={inner} />
    </div>
    <script is:inline src="/js/main.js"></script>
    <script is:inline src="/js/giscus.js" defer></script>
  </body>
</html>

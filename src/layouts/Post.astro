---
import Base from './Base.astro';

interface Props {
    title: string;
    description: string;
    lang: 'en' | 'ar';
    dateLabel: string;
    selfPath: string;
    pageTitle?: string;
    raw?: string;
    rawCss?: string;
}

const { title, description, lang, dateLabel, selfPath, pageTitle, raw, rawCss } = Astro.props;
---
<Base
  title={`${pageTitle ?? title} | Khaled Alwakeel`}
  description={description}
  lang={lang}
  selfPath={selfPath}
  inner
>
  {rawCss && <Fragment slot="head" set:html={`<style>${rawCss}</style>`} />}
  {raw ? <Fragment set:html={raw} /> : (
  <>
  <article class="container" style="padding-top: 3rem;">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">{dateLabel}</p>
      <div class="post-share">
        <span class="post-share-label">Share</span>
        <a href="#" class="post-share-btn post-share-twitter" aria-label="Share on X (Twitter)" title="Share on X">𝕏</a>
        <a href="#" class="post-share-btn post-share-linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <button type="button" class="post-share-btn post-share-copy" aria-label="Copy link" title="Copy link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
  <section class="giscus-section container" aria-label="Comments">
    <div id="giscus-container"></div>
  </section>
  </>
  )}
</Base>
